generate_fstab() {
FILE="${LFS}/etc/fstab"
[ -f $FILE ] && return
cat > $FILE << "EOF"
# Begin /etc/fstab

# filesystem  mount-point                  type       options                        dump  fsck
#                                                              order
# Exemple de montage nfs
# 192.168.254.254:/home/thierry /home/thierry nfs rw,vers=3,_netdev,rsize=8192,wsize=8192 0 0
EOF
}
generate_bashrc() {
FILE="${LFS}/etc/skel/.bashrc"
[ -f $FILE ] && return
cat > $FILE << "EOF"
# Personal aliases and functions.

# Personal environment variables and startup programs should go in
# ~/.bash_profile.  System wide environment variables and startup
# programs are in /etc/profile.  System wide aliases and functions are
# in /etc/bashrc.

if [ -f "/etc/bashrc" ] ; then
        source /etc/bashrc
fi
if [ $EUID -eq 0 ] ; then
	alias nu='setup-nutyx -cu'
	alias del='cards remove'
	alias get='cards install'
	alias up='cards install -u'
	alias check='cards sync && cards diff'
	alias sysup='cards upgrade'
	alias upcheck='cards sync && cards upgrade -s'
else
	alias nu='sudo setup-nutyx -cu'
	alias del='sudo cards remove'
	alias get='sudo cards install'
	alias up='sudo cards install -u'
	alias check='sudo cards sync && cards diff'
	alias sysup='sudo cards upgrade'
	alias upcheck='sudo cards sync && sudo cards upgrade -s'
fi
alias search='cards search'
alias ll='ls -l'
alias l='ls -alh'
alias duh='du -h --max-depth=1'
alias dfh='df -h'
alias pkgfind='cards list | grep -i'
alias paste-nutyx='curl -F '\''f:1=<-'\'' http://sprunge.us'

$(which fastfetch)
# End ~/.bashrc
EOF
[ -f ${LFS}/root/.bashrc ] && return
install -dv -m0750 ${LFS}/root
cp $OPTION $FILE \
${LFS}/root
}
generate_bash_profile() {
FILE="${LFS}/etc/skel/.bash_profile"
[ -f $FILE ] && return
cat > $FILE << "EOF"
# Personal environment variables and startup programs.

# Personal aliases and functions should go in ~/.bashrc.  System wide
# environment variables and startup programs are in /etc/profile.
# System wide aliases and functions are in /etc/bashrc.

append () {
 local OPTION
 [ -z $QUIET ] && OPTION="--verbose"
  # First remove the directory
  local IFS=':'
  local NEWPATH
  for DIR in $PATH; do
         if [ "$DIR" != "$1" ]; then
           NEWPATH=${NEWPATH:+$NEWPATH:}$DIR
         fi
  done
  # Then append the directory
  export PATH=$NEWPATH:$1
}

if [ -f "$HOME/.bashrc" ]; then
        source $HOME/.bashrc
fi

# unset append

# End ~/.bash_profile
EOF
[ ! -d ${LFS}/root ] && install -d $OPTION -m0750 ${LFS}/root
cp $OPTION $FILE \
${LFS}/root
}
generate_cards_conf() {
FILE="$LFS/etc/cards.conf"
[ -f $FILE ] && return
[ "$DEPOT" == "$MOUNT" ] || $ECHO "
# Default server URL
url ${URL}
#
## For all the graphical applications and desktops
collection gui-extra
#
## For a minimal graphical interface
collection gui
#
## For all the console applications
collection cli-extra
#
## For a minimal console interface
collection cli
#
## Chroot system without reboot possibilities for a chroot
collection base
#" >> $FILE
}
generate_nutyx_version() {
FILE="${LFS}/var/lib/pkg/nutyx-version"
[ -f $FILE ] && return
$ECHO "name ${CODE_NAME}
depot /var/lib/pkg/depot
version $VERSION" > $FILE
}
generate_lsb() {
$ECHO "DISTRIB_ID=\"NuTyX\"
DISTRIB_DESCRIPTION=\"NuTyX GNU/Linux\"
DISTRIB_CODENAME=\"${CODE_NAME}\"
DISTRIB_RELEASE=\"$VERSION\"
LSB_VERSION=\"1.4-1\"" > ${LFS}/etc/lsb-release
}
generate_osr() {
$ECHO "URL_HOME=\"https://www.nutyx.org\"
NAME=\"NuTyX\"
VERSION=\"$VERSION\"
ID=nutyx
PRETTY_NAME=\"NuTyX GNU/Linux\"
VERSION_CODENAME=\"${CODE_NAME}\"" > ${LFS}/usr/lib/os-release
ln -sf $OPTION ../usr/lib/os-release ${LFS}/etc/os-release
}
