FILE="${LFS}/etc/passwd"
[ -f $FILE ] && return
cat > $FILE << "EOF"
root::0:0:root:/root:/usr/bin/bash
bin:x:1:1:bin:/dev/null:/usr/bin/false
daemon:x:6:6:Daemon User:/dev/null:/usr/bin/false
lp:x:9:9:Print Service User:/dev/null:/usr/bin/false
atd:x:17:17:add daemon:/dev/null:/usr/bin/false
