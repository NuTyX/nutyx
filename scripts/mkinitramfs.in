# Authors:         Alexander E. Patrakov and Jeremy Huntwork.
#                  Thierry Nuttens for NuTyX

error() {
    printf "$1"
    exit 1
}
copyModules() {
local MODULES
MODULES="${MODULES_DIR}/$KERNEL_VERSION/kernel/crypto \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/fs         \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/lib        \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/hv \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/scsi    \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/message \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/virtio  \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/md      \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/ata     \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/block   \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/mmc     \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/misc    \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/misc/cardreader \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/cdrom   \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/nvme    \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/usb/host    \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/usb/storage \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/usb/core    \
     ${MODULES_DIR}/$KERNEL_VERSION/kernel/drivers/usb/common"

printf "Copying $(find $MODULES -type f | wc -l) modules...\n"
find $MODULES -type f 2> /dev/null | $CPIO --make-directories -p  $WDIR 2> /dev/null

mkdir -p $WDIR${MODULES_DIR}/$KERNEL_VERSION
for i in builtin order
do
   cp ${MODULES_DIR}/$KERNEL_VERSION/modules.$i \
   $WDIR${MODULES_DIR}/$KERNEL_VERSION
done
touch $WDIR${MODULES_DIR}/$KERNEL_VERSION/modules.builtin.modinfo

[ -f ${MODULES_DIR}/$KERNEL_VERSION/modules.builtin.modinfo ] && \
   cp ${MODULES_DIR}/$KERNEL_VERSION/modules.builtin.modinfo \
   $WDIR${MODULES_DIR}/$KERNEL_VERSION

find $WDIR${MODULES_DIR}/$KERNEL_VERSION/kernel -type f \
-exec unzstd --rm {} >/dev/null 2>&1 \;

depmod -b $WDIR $KERNEL_VERSION
}

copyFirmwares()
{
  cp -a /lib/firmware/amd-ucode \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/rtlwifi \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/ath6k \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/RTL8192E \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/bnx2x-* \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/brcm \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/iwlwifi-* \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/radeon \
  $WDIR/lib/firmware > /dev/null 2>&1
  cp -a /lib/firmware/ar3k \
  $WDIR/lib/firmware > /dev/null 2>&1
}
copy()
{
  local file

  if [ "$2" == "lib" ]; then
    file=$(PATH=/lib:/usr/lib:/$SYSTEMDDIR type -p $1)
  else
    file=$(PATH=/usr/sbin:/usr/bin:/$SYSTEMDDIR type -p $1)
  fi

  if [ "$file" != "" ] ; then
    if  [ "$(dirname $1)" == "/lib64" ]; then
        mkdir $WDIR/lib64
        ln -s ../lib/$(basename $1) \
        $WDIR/$1
        cp /lib/$(basename $1) $WDIR/lib
    else
        ldd $file | sed "s/\t//" | cut -d " " -f1 >> $unsorted
        cp $file $WDIR/$file
    fi
  fi
}

#
##
### Start Here
PATH=/usr/bin:/usr/sbin
BUSYBOX=$(PATH=/usr/sbin:/usr/bin:/bin type -p busybox)
[ -z $BUSYBOX ] && error "busybox needs to be installed !!!"
CPIO=$(which cpio)
MDADM=$(which madm)
LVM=$(which lvm)
CRYPTSETUP=$(which cryptsetup)
SHAREDIR=/usr/share/nutyx
SYSTEMDDIR=usr/lib/systemd
# Create temporaries working directories
WDIR=$(mktemp -d /tmp/initrd-work.XXXXXXXXXX)
unsorted=$(mktemp /tmp/unsorted.XXXXXXXXXX)

# Create base directory structure
for DIR in $SYSTEMDDIR usr/bin usr/sbin usr/share usr/lib/udev/rules.d \
usr/lib/udev/hwdb.d etc/modprobe.d /etc/udev/rules.d lib/firmware \
dev tmp run sys proc
do
   mkdir -p $WDIR/$DIR
done

cp $BUSYBOX $WDIR/usr/bin/
for LINK in $($BUSYBOX  --list)
do
  [ "$LINK" == "$(basename $BUSYBOX)" ] && continue
  [ "$LINK" == "init" ] && continue
  ln -s busybox $WDIR/usr/bin/$LINK
done

touch $WDIR/etc/modprobe.d/modprobe.conf

KERNEL_VERSION="$(uname -r)"
MODULES_DIR="/usr/lib/modules"

if [ -z $1 ]; then
	if [ ! -d ${MODULES_DIR}/${KERNEL_VERSION} ]; then
		printf "Error you didn't specify any kernel version !!
The ${MODULES_DIR}/${KERNEL_VERSION} directory not exist !!"

	else
		printf "Warning you didn't specify any kernel version !!
Will try to make for ${KERNEL_VERSION}. If not,"
	fi
	printf "
==> Please choose one from following kernel(s) version(s):
"
	ls  ${MODULES_DIR}
	printf ""
	[ ! -d ${MODULES_DIR}/${KERNEL_VERSION} ] && exit 1
else
	KERNEL_VERSION=$1
fi

INITRAMFS_FILE=initrd-${KERNEL_VERSION}

printf "Creating $INITRAMFS_FILE... \n"

[ -n "$KERNEL_VERSION" ] && [ ! -d "${MODULES_DIR}/$1" ] && \
error "No ${MODULES_DIR}/$1 directory"


copyFirmwares

systemdfiles="systemd-udevd"
xfiles="udevadm udevd"

##  Optional files and locations need bash
##   so that ldd can find librairies
if [ -x $LVM ] || [ -x $CRYPTSETUP ] || [ -x $MDADM ]; then
	! [ -x /usr/bin/bash ] &&
    error "bash needs to be installed !!!"

fi

# Add mdadm if present
if [ -x $MDADM ];then
    xfiles+=" mdadm"

# Copy the RAID configuration file if present
   [ -f /etc/mdadm.conf ] && cp /etc/mdadm.conf $WDIR/etc
fi

# Add lvm if present
if [ -x $LVM ]; then
    xfiles+=" lvm dmsetup"
    for f in lvchange lvrename lvextend lvcreate lvdisplay lvscan pvck \
        pvcreate pvdisplay pvscan vgchange vgcreate vgscan vgrename vgck
    do
        ln -s lvm $WDIR/$(dirname $LVM)/$f
    done

    # Conf file(s)
    cp -a /etc/lvm $WDIR/etc
fi

# Add cryptsetup if present
if [ -x $CRYPTSETUP ]; then
    xfiles+=" cryptsetup"
    if [ -f /root/.crypto/keyfile.bin ]; then
        mkdir -p $WDIR/root/.crypto
        cp /root/.crypto/keyfile.bin $WDIR/root/.crypto
    fi
fi

# Install the init script
install -m0755 ${SHAREDIR}/init.in $WDIR/init || \
error "ERROR cannot find ${SHAREDIR}/init.in file !!!"


cp /etc/group $WDIR/etc
cp /etc/passwd $WDIR/etc

if [ -d /etc/mdev.d ]; then
  [ -f /etc/mdev.conf ] && \
  cp /etc/mdev.conf $WDIR/etc
  cp -a /etc/mdev.d $WDIR/etc/mdev.d
fi

# Install the udev configuration files
[ -f /etc/udev/udev.conf ] && cp /etc/udev/udev.conf $WDIR/etc/udev/udev.conf
for file in $(find /usr/lib/udev/rules.d/ -type f) ; do
	cp $file $WDIR/usr/lib/udev/rules.d
done
for file in $(find /usr/lib/udev/hwdb.d/ -type f) ; do
	cp $file $WDIR/usr/lib/udev/hwdb.d
done


# Install basic binaries
for f in $xfiles $systemdfiles; do
    copy $f
done

# Install libraries
sort $unsorted | uniq | while read library ; do
  if [ "$library" == "linux-vdso.so.1" ] ||
     [ "$library" == "linux-gate.so.1" ]; then
    continue
  fi
  copy $library lib
done

cp -a /usr/lib/udev $WDIR/usr/lib

###  Install requested $KERNEL_VERSION kernel modules
[ -z ${KERNEL_VERSION} ] || copyModules

rm -f /boot/$INITRAMFS_FILE

( cd $WDIR ; find . | $CPIO -o -H newc --quiet | zstd -17 ) > $INITRAMFS_FILE


# Remove the temporary direc
rm -rf $WDIR $unsorted
mv $INITRAMFS_FILE /boot/$INITRAMFS_FILE

printf "done.\n"
